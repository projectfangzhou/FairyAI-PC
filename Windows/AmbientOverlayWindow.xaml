<Window x:Class="MyAiAssistant.Windows.AmbientOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:MyAiAssistant.Controls"
        xmlns:local="clr-namespace:MyAiAssistant.Converters"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Left="0" Top="0"
        Width="{Binding Source={x:Static SystemParameters.PrimaryScreenWidth}}"
        Height="{Binding Source={x:Static SystemParameters.PrimaryScreenHeight}}"
        Loaded="OnLoaded"
        Closing="OnClosing">

    <Grid x:Name="RootGrid" Background="Transparent" ClipToBounds="True">

        <!-- Rainbow glow layer (click-through) -->
        <ctrl:GlowBorder x:Name="GlowBorder" IsHitTestVisible="False" />

        <!-- Right slide-in panel -->
        <Border x:Name="PanelRegion"
                HorizontalAlignment="Right"
                Width="300"
                Background="#DD080816"
                BorderBrush="#337850EE"
                BorderThickness="1,0,0,0"
                RenderTransformOrigin="1,0.5"
                IsHitTestVisible="True">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PanelSlideTransform" X="300" />
            </Border.RenderTransform>

            <DockPanel>
                <!-- Header -->
                <StackPanel DockPanel.Dock="Top" Margin="16,16,16,8">
                    <TextBlock Text="FAIRY" Foreground="#8888AA"
                               FontSize="10" FontWeight="Light" />
                    <TextBlock Text="{Binding StatusText}" Foreground="#555"
                               FontSize="9" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Waveform at bottom -->
                <ctrl:WaveformVisualizer x:Name="Waveform"
                                         DockPanel.Dock="Bottom"
                                         Height="44"
                                         Margin="0,8,0,12"
                                         IsActive="{Binding IsListening}"
                                         Amplitude="{Binding AudioLevel}" />

                <!-- Divider -->
                <Border DockPanel.Dock="Bottom" Height="1"
                        Background="#15FFFFFF" Margin="16,4" />

                <!-- Chat messages area -->
                <ScrollViewer DockPanel.Dock="Top"
                              VerticalScrollBarVisibility="Auto"
                              Margin="0">
                    <ItemsControl ItemsSource="{Binding Messages}"
                                  Margin="12,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <!-- User message (right-aligned) -->
                                    <Border HorizontalAlignment="Right"
                                            MaxWidth="250"
                                            Background="#22FF0080"
                                            CornerRadius="10,10,3,10"
                                            Padding="10"
                                            Margin="0,2"
                                            Visibility="{Binding Role, Converter={x:Static local:RoleToVisibilityConverter.User}}">
                                        <TextBlock Text="{Binding Content}"
                                                   Foreground="#E0E0F0"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                    <!-- AI message (left-aligned) -->
                                    <Border HorizontalAlignment="Left"
                                            MaxWidth="250"
                                            Background="#147850EE"
                                            CornerRadius="10,10,10,3"
                                            Padding="10"
                                            Margin="0,2"
                                            Visibility="{Binding Role, Converter={x:Static local:RoleToVisibilityConverter.AI}}">
                                        <TextBlock Text="{Binding Content}"
                                                   Foreground="#B8B8D0"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
