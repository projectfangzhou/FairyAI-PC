<Window x:Class="MyAiAssistant.Windows.ClipboardHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="剪贴板历史 - Fairy AI"
        Width="420" Height="560"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="剪贴板历史" Foreground="#7b68ee" FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="清空" Width="60" Height="28"
                    Background="#333" Foreground="#aaa" BorderThickness="0"
                    Click="OnClearClick"/>
        </Grid>

        <ListBox Grid.Row="1" x:Name="HistoryList" Background="#2a2a3e" Foreground="#ddd"
                 BorderThickness="0" SelectionMode="Single"
                 MouseDoubleClick="OnHistoryDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4">
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#ddd"
                                   MaxHeight="60" TextTrimming="CharacterEllipsis" FontSize="13"/>
                        <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm:ss}" Foreground="#666"
                                   FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
