<Window x:Class="MyAiAssistant.Windows.DynamicIslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fairy Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="380" Height="120"
        Top="4"
        Visibility="Collapsed"
        Loaded="OnLoaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border x:Name="IslandBorder"
            CornerRadius="18"
            Background="#ee111118"
            BorderBrush="#337b68ee"
            BorderThickness="1"
            Margin="0,0,0,4"
            RenderTransformOrigin="0.5,0">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="IslandScale" ScaleX="0.1" ScaleY="0.05"/>
                <TranslateTransform x:Name="IslandTranslate" Y="-20"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Border.Effect>
            <DropShadowEffect Color="#7b68ee" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>

        <Grid Margin="16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Status bar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <Ellipse Width="6" Height="6" Fill="#40e0d0" Margin="0,0,6,0">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="StatusDot" ScaleX="1" ScaleY="1"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <TextBlock x:Name="StatusText" Text="点击开始对话" Foreground="#888" FontSize="10"/>
            </StackPanel>

            <!-- Waveform + Response area -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <!-- Waveform bars (shown during listening) -->
                <StackPanel x:Name="WaveformPanel" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <!-- 16 bars generated in code-behind -->
                </StackPanel>

                <!-- Response text (shown during/after response) -->
                <ScrollViewer x:Name="ResponseScroll" VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <TextBlock x:Name="ResponseText" Text="" Foreground="#ddd" FontSize="12"
                               TextWrapping="Wrap" LineHeight="18"/>
                </ScrollViewer>

                <!-- Transcription text (shown during listening) -->
                <TextBlock x:Name="TranscriptionText" Text="" Foreground="#aaa" FontSize="11"
                           TextWrapping="Wrap" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>

            <!-- Close button -->
            <Button Grid.Row="2" HorizontalAlignment="Right"
                    Background="Transparent" BorderThickness="0"
                    Padding="4,2" Cursor="Hand"
                    Click="OnCloseClicked">
                <TextBlock Text="✕" Foreground="#666" FontSize="10"/>
            </Button>
        </Grid>
    </Border>
</Window>
