<Window x:Class="MyAiAssistant.Windows.FloatingOrbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fairy"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="48" Height="48"
        Top="8"
        Cursor="Hand"
        MouseLeftButtonDown="OnOrbClicked"
        Loaded="OnLoaded">

    <Grid>
        <!-- Outer glow ring -->
        <Ellipse Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#607b68ee" Offset="0"/>
                    <GradientStop Color="#007b68ee" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="GlowScale" ScaleX="1" ScaleY="1"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Core orb -->
        <Ellipse Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Cursor="Hand" MouseLeftButtonDown="OnOrbClicked">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#bb7b68ee" Offset="0"/>
                    <GradientStop Color="#553a2a6e" Offset="0.7"/>
                    <GradientStop Color="#001a1a2e" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="2"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Center dot -->
        <Ellipse Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Fill="#ddbbccff"/>
    </Grid>
</Window>
